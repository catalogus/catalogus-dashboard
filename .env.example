# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_STOREFRONT_URL=https://catalogus.co.mz
VITE_CMS_URL=https://admin.catalogus.co.mz

# Auth redirect target used for password recovery and related CMS flows.
# This should match the production admin domain and be allowlisted in Supabase Auth URL configuration.
# Example redirect URL: https://admin.catalogus.co.mz/auth/reset-password

# Umami Analytics (optional)
# Get your API token from https://cloud.umami.is/settings/api-tokens
VITE_UMAMI_API_TOKEN=your_umami_api_token
